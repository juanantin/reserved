# Copy to .env and fill in before deploying. NEVER commit the real .env file.

# Private key of the deployer wallet (no 0x prefix or with, hardhat accepts both).
DEPLOYER_PRIVATE_KEY=

# RPC endpoints
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
BSC_MAINNET_RPC_URL=https://bsc-dataseed.bnbchain.org

# Etherscan API key (unified V2 multichain API — covers BscScan too as of 2025;
# get one at https://etherscan.io/myapikey), for contract verification.
ETHERSCAN_API_KEY=
