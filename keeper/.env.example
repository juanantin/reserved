# Copy to .env and fill in before running. NEVER commit the real .env file.

# BSC RPC endpoint (mainnet or testnet, matching wherever TreasuryConverter is deployed).
RPC_URL=https://bsc-dataseed.bnbchain.org

# Private key of the wallet set as TreasuryConverter.keeper (or its owner). This wallet
# can only ever trigger the converter's bounded, price-checked, pre-allowlisted
# functions — it has no path to withdraw funds itself — but protect the key anyway:
# anyone holding it can trigger sells/buys within those bounds at will.
KEEPER_PRIVATE_KEY=

# Deployed contract addresses. WBNB is deliberately not listed here — the bot reads it
# on-chain from converter.WBNB() instead of trusting a second hand-entered copy.
CONVERTER_ADDRESS=
RSVD_ADDRESS=

# Comma-separated list of bStocks to rebalance into, each as SYMBOL:address, or
# SYMBOL:address:hop1:hop2 if the deepest route isn't a direct WBNB/token pair. Extra
# fields after the address are intermediate hops the swap path passes through *between*
# WBNB and the token (e.g. WBNB -> USDT -> bStock needs SYMBOL:BSTOCK_ADDRESS:USDT_ADDRESS).
# Each address here must also be allowlisted on-chain via
# converter.setAllowedReserveAsset(address, true) — this list only controls what the
# bot *attempts*, the contract's own allowlist is what actually gates it.
# Example: BSTOCKS=NVDAB:0x...,TSLAB:0x...
BSTOCKS=

# How often the main loop runs, in seconds. TreasuryConverter's minTwapWindow is
# typically 10+ minutes, so there's little value polling much faster than that.
POLL_INTERVAL_SECONDS=900

# Dust filters — don't bother converting amounts too small to be worth the gas.
MIN_RSVD_TO_SELL=1000
MIN_BNB_TO_BUY=0.05

# Binance API fallback (see src/binanceFallback.ts) — NOT IMPLEMENTED. Setting these
# does not enable real fallback behavior; the function still throws until someone with
# a live Binance account implements and tests the signed buy + withdrawal flow.
BINANCE_API_KEY=
BINANCE_API_SECRET=
VAULT_ADDRESS=
